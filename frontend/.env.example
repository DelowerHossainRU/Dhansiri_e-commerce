# =============================================================================
# DHANSIRI AGRO FRONTEND CONFIGURATION EXAMPLE (.env.example)
# Copy this file to .env and adjust values for your environment.
# =============================================================================

# Server Network Configuration
VITE_PORT=5173
VITE_HOST=0.0.0.0

# Backend API & Media Target (Used for Vite Dev Proxy & Axios Base URL)
VITE_BACKEND_URL=http://localhost:5000
VITE_API_URL=/api

# Default Brand Theme & Typography Configuration
# Available themes: golden-harvest | royal-basmati | emerald-heritage | agro-noir | terracotta-earth
# Available fonts:  playfair | outfit | cinzel | jakarta | noto
VITE_DEFAULT_THEME=golden-harvest
VITE_DEFAULT_FONT=playfair

# Application Metadata
VITE_APP_NAME="DHANSIRI AGRO"
VITE_APP_TAGLINE="Premium Agricultural Marketplace & B2B Agribusiness Platform"
VITE_DEFAULT_CURRENCY=BDT
VITE_DEFAULT_CURRENCY_SYMBOL=৳
VITE_SUPPORT_PHONE="+880 1711-000000"
VITE_SUPPORT_EMAIL="support@dhansiriagro.com"
